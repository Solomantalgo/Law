# Server-only variables. Do not prefix these names with VITE_.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Upstash Redis REST credentials for shared, serverless-safe rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONTACT_RATE_LIMIT_HASH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
